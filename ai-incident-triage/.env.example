# --- LLM Provider Selection ---
# "openrouter" (default) or "groq" -- switching this alone changes the
# provider for every agent, no code changes required.
LLM_PROVIDER=openrouter

# --- OpenRouter (default provider) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Groq (alternate provider, selected via LLM_PROVIDER=groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Shared generation settings (apply to whichever provider is active) ---
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# --- Email (Resend) ---
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=alerts@yourdomain.com
RESEND_FROM_NAME=Incident Triage Bot

# --- Knowledge Base Settings ---
# Similarity threshold for runbook auto-updates (0.0 to 1.0)
RUNBOOK_UPDATE_SIMILARITY_THRESHOLD=0.80

# --- Optional integrations ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=